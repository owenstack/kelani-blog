---
import { GoogleSignIn } from "@/components/google";
import Logo from "@/components/logo.astro";
import Layout from "./layouts/Layout.astro";
---

<Layout title="Log in">
    <section class="min-h-screen flex items-center justify-center bg-muted/40 p-4">
        <div class="w-full max-w-sm">
            <div class="bg-card text-card-foreground rounded-lg shadow-md p-8 text-center">
                <div class="mb-6">
                    <Logo className="text-2xl" />
                </div>
                <h1 class="text-2xl font-semibold mb-2">
                    Log in to your account
                </h1>
                <p class="text-muted-foreground mb-6">
                    Continue with your Google account to access your dashboard.
                </p>
                <GoogleSignIn client:load />
            </div>
        </div>
    </section>
</Layout>