{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "beyond-dogma",
	"main": "./dist/_worker.js",
	"compatibility_date": "2025-10-05",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist",
		"not_found_handling": "404-page"
	},
	"observability": {
		"enabled": true
	}
}
