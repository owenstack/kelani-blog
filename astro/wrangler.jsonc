{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "beyond-dogma",
	"main": "./dist/_worker.js",
	"compatibility_date": "2025-10-05",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist",
		"not_found_handling": "404-page"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "beyond_dogma_db",
			"database_name": "beyond-dogma-db",
			"database_id": "533b68f9-0804-45de-ba79-19ed53b88203"
		}
	]
}
